# ==============================================================================
# AGROCONTROL PRO - .gitignore
# ==============================================================================
# Nota: gitignore NO admite comentarios al final de una línea; un "# ..." tras
# un patrón pasa a formar parte del patrón y lo invalida. Comente siempre en
# líneas propias.

# ── Dependencias de paquetes ──────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Entornos y variables sensibles (NUNCA subir al repositorio) ───────────────
.env
.env.*
*.env
# Las plantillas sin secretos sí se versionan
!.env.example
!*.env.example

# ── Certificados, claves privadas y credenciales ──────────────────────────────
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
keystore.jks
# Firebase / Play Store (si se agrega en el futuro)
google-services.json

# ── Compilación y artefactos de build ─────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo
# Paquetes generados de la app móvil
*.apk
*.aab

# ── Base de datos local, volúmenes y respaldos ────────────────────────────────
# Los backups viven fuera del repositorio (regla 3-2-1)
backups/
*.backup
*.dump
*.sql.gz
*.sql.gz.enc
*.enc
pgdata/
.postgres/
database/data/

# ── Documentación y material interno / confidencial ───────────────────────────
docs/
SKILL/

# ── Logs del sistema ──────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Cobertura de pruebas ──────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Caché de herramientas ─────────────────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
.turbo/
.eslintcache

# ── Configuraciones de IDE y Sistema Operativo ────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ── Overrides de Docker para desarrollo individual ────────────────────────────
docker-compose.override.yml
docker-compose.local.yml
