generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auditoria {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidad        String   @db.VarChar(50)
  registro_id    String   @db.Uuid
  accion         String   @db.VarChar(20)
  valor_anterior Json?
  valor_nuevo    Json?
  usuario_id     String?  @db.Uuid
  dispositivo_id String?  @db.Uuid
  ip_origen      String?  @db.VarChar(45)
  fecha          DateTime @default(now()) @db.Timestamptz(6)
  usuario        usuario? @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([entidad, registro_id], map: "ix_auditoria_entidad_registro")
  @@index([fecha], map: "ix_auditoria_fecha")
  @@index([usuario_id], map: "ix_auditoria_usuario")
}

model categoria {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo         String     @unique @db.VarChar(30)
  nombre         String     @db.VarChar(100)
  descripcion    String?
  activo         Boolean    @default(true)
  creado_en      DateTime   @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime   @default(now()) @db.Timestamptz(6)
  producto       producto[]

  @@index([actualizado_en], map: "ix_categoria_actualizado_en")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cliente {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_documento   String       @default("DNI") @db.VarChar(10)
  numero_documento String       @db.VarChar(20)
  razon_social     String       @db.VarChar(200)
  direccion        String?      @db.VarChar(250)
  telefono         String?      @db.VarChar(30)
  email            String?      @db.VarChar(100)
  lista_precio_id  String       @db.Uuid
  activo           Boolean      @default(true)
  creado_en        DateTime     @default(now()) @db.Timestamptz(6)
