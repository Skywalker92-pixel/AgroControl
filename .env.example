# ==============================================================================
# AGROCONTROL PRO - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Plantilla SIN secretos reales. Copie a .env y reemplace cada CHANGE_ME.
# Con NODE_ENV=production el backend se niega a arrancar si detecta valores de
# ejemplo (CHANGE_ME, demo, default, secret, password...) en los secretos.
#
# Generar valores aleatorios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ==============================================================================

# Entorno: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL 15)
# ------------------------------------------------------------------------------
DB_HOST=agrocontrol-db
DB_PORT=5432
# Puerto expuesto en la PC host (5433 para no colisionar con otros PostgreSQL)
HOST_DB_PORT=5433
DB_NAME=agrocontrol_db
DB_USER=agrocontrol_user
DB_PASSWORD=CHANGE_ME

# Cadena de conexión del backend (red interna de Docker). Debe usar la misma
# contraseña que DB_PASSWORD. Si se omite, docker-compose la construye.
DATABASE_URL=postgresql://agrocontrol_user:CHANGE_ME@agrocontrol-db:5432/agrocontrol_db?schema=public

# ------------------------------------------------------------------------------
# BACKEND API (NestJS / Node 20)
# ------------------------------------------------------------------------------
API_PORT=3000
HOST_API_PORT=3000
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h

# Orígenes (esquema://host[:puerto]) desde los que se abre la web, separados por
# comas. Obligatorio en producción; no se admite '*'.
# Ej. instalación local en la LAN: http://192.168.1.10:8080
CORS_ORIGINS=

# Proxies de confianza para obtener la IP real del cliente (auditoría y rate limit).
# Por defecto: solo redes privadas (Nginx en Docker). En Render/PaaS usar 1.
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# PRIMERA INSTALACIÓN (Docker): administrador inicial
# ------------------------------------------------------------------------------
# Solo se usa cuando el volumen de PostgreSQL está vacío. Elimine la contraseña
# del .env después del primer arranque.
INITIAL_ADMIN_USERNAME=propietario
INITIAL_ADMIN_NOMBRE=Administrador Propietario
INITIAL_ADMIN_PASSWORD=

# Datos FICTICIOS de demostración (usuarios demo.* y catálogo de ejemplo).
# NUNCA en producción: las contraseñas demo son públicas.
ENABLE_DEMO_SEED=false

# ------------------------------------------------------------------------------
# FRONTEND WEB (Nginx + Vite SPA)
# ------------------------------------------------------------------------------
WEB_PORT=80
HOST_WEB_PORT=8080

# ------------------------------------------------------------------------------
# COPIAS DE SEGURIDAD (pg_dump + AES-256 con OpenSSL)
# ------------------------------------------------------------------------------
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
# Mínimo 32 caracteres aleatorios. Guárdela fuera del servidor: sin ella los
# respaldos no se pueden restaurar.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_WITH_SECURE_RANDOM_VALUE
CRON_SCHEDULE="0 2 * * *" # Todos los días a las 02:00 AM

# ------------------------------------------------------------------------------
# REGLAS DE NEGOCIO CONFIGURABLES
# ------------------------------------------------------------------------------
# Momento exacto de descuento de stock en despacho: DESPACHADO | PREPARADO
DISPATCH_STOCK_DEDUCT_EVENT=DESPACHADO

# Estrategia de valorización de Kárdex: PROMEDIO_PONDERADO | PEPS
METODO_VALORIZACION_DEFAULT=PROMEDIO_PONDERADO
