# ==============================================================================
# AGROCONTROL PRO - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# Entorno: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL 15-alpine / 16-alpine)
# ------------------------------------------------------------------------------
DB_HOST=agrocontrol-db
DB_PORT=5432
# Puerto expuesto en la PC host (se usa 5433 por defecto para evitar colisiones con otros Postgres locales)
HOST_DB_PORT=5433
DB_NAME=agrocontrol_db
DB_USER=agrocontrol_user
DB_PASSWORD=agrocontrol_secret_pass_2026

# Cadena de conexión para Backend / ORM (acceso interno en red Docker)
DATABASE_URL=postgresql://agrocontrol_user:agrocontrol_secret_pass_2026@agrocontrol-db:5432/agrocontrol_db?schema=public

# ------------------------------------------------------------------------------
# BACKEND API (NestJS / Node 20)
# ------------------------------------------------------------------------------
API_PORT=3000
HOST_API_PORT=3000
JWT_SECRET=super_seguro_jwt_secret_agrocontrol_2026_pro_token
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# FRONTEND WEB (Nginx + Vite SPA)
# ------------------------------------------------------------------------------
WEB_PORT=80
HOST_WEB_PORT=8080

# ------------------------------------------------------------------------------
# COPIAS DE SEGURIDAD (pg_dump automatizado)
# ------------------------------------------------------------------------------
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=AgroControl2026BackupEncryptionKeySecret32b
CRON_SCHEDULE="0 2 * * *" # Todos los días a las 02:00 AM

# ------------------------------------------------------------------------------
# REGLAS DE NEGOCIO CONFIGURABLES (PUNTOS "POR VALIDAR")
# ------------------------------------------------------------------------------
# Momento exacto de descuento de stock en despacho: DESPACHADO | PREPARADO
DISPATCH_STOCK_DEDUCT_EVENT=DESPACHADO

# Estrategia de valorización de Kárdex: PROMEDIO_PONDERADO | PEPS
METODO_VALORIZACION_DEFAULT=PROMEDIO_PONDERADO
