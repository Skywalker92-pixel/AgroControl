# ==============================================================================
# AGROCONTROL PRO - FRONTEND: VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copie a .env.local (no se versiona). Todas las variables VITE_* quedan
# incrustadas en el JavaScript público: NUNCA coloque secretos aquí.

# URL base de la API backend.
#  - Desarrollo y Docker (Nginx): dejar vacío -> usa '/api' del mismo origen.
#  - Despliegue separado (p. ej. Vercel + Render): URL pública de la API, p. ej.
#    VITE_API_URL=https://<su-api>.onrender.com/api
VITE_API_URL=

# Datos del negocio impresos en actas, órdenes de despacho y reportes (opcional).
VITE_EMPRESA_NOMBRE=AGROCONTROL PRO
VITE_EMPRESA_RUC=
VITE_EMPRESA_DIRECCION=

# ------------------------------------------------------------------------------
# SOLO DESARROLLO LOCAL (`npm run dev`). Sin efecto en `npm run build`.
# Muestra accesos rápidos a las cuentas FICTICIAS de
# database/seeds/001_seed_usuarios_demo.sql.
# ------------------------------------------------------------------------------
VITE_ENABLE_DEMO_ACCOUNTS=false
# Contraseña de las cuentas ficticias (ver el seed). Solo en .env.local.
VITE_DEMO_PASSWORD=
